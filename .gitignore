# Per-comp config (machine-local; created from .comp.env.template)
.comp.env

# Data — keep placeholder, ignore content
data/*
!data/.gitkeep

# Submissions / kernel build artifacts
submissions/*
!submissions/.gitkeep

# External Kaggle kernels pulled for reference
external/kernels/*/
!external/kernels/.gitkeep

# Replays from local simulator runs
replays/
audit/replays/
audit/manifold/

# Live ladder episode replays pulled via `kaggle competitions replay`
# (~4MB per game; *.csv index files are already covered by the rule below).
# Allow the small `summary.json` aggregated by scripts/live_episode_summary.py
# (diagnosis history is worth keeping in git).
audit/live-episodes/*/episode-*.json
!audit/live-episodes/*/summary.json
# Per-episode postmortem outputs from scripts/episode_postmortem.py are
# 100-500 KB each; keep only the aggregated roll-up.json in git.
audit/live-episodes/*/postmortem/postmortem-*.json
!audit/live-episodes/*/postmortem/roll-up.json

# Parallel-branch agents extracted via `git show` for cross-architecture
# A/B comparisons (see audit/2026-05-11-v3-snipe-critical-review.md §6.5).
# Source of truth lives on its own branch; we don't track a copy here.
agents/precision/

# Common data formats
*.csv
*.zip

# RL model checkpoints can be large
*.pkl
*.pt
*.pth
*.onnx

# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
venv/

# Kaggle credentials (NEVER commit these)
.kaggle/

# Claude Code local settings (may contain secrets)
.claude/settings.local.json

# Jupyter
.ipynb_checkpoints/

# OS noise
.DS_Store
Thumbs.db

# External Kaggle data pulled for analysis (~350 MB bulk fetch).
# Analysis products live in audit/*.json + knowledge-base/concepts/.
audit/external/
